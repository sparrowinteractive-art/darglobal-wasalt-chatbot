# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Comma separated fallback chain, first is primary
OPENROUTER_MODELS=google/gemma-4-31b-it:free,z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m2.7:free
# Comma separated origins allowed to call the API (Vercel frontend URL)
CORS_ORIGINS=*
PORT=8000
# Optional: Sarvam AI as an extra fallback provider (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_MODELS=sarvam-105b-conversations
